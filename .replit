modules = ["python-3.12", "web"]
run = "python -m uvicorn app.web.main:app --host 0.0.0.0 --port 5000 --reload"

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "python -m uvicorn app.web.main:app --host 0.0.0.0 --port 5000"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn app.web.main:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
